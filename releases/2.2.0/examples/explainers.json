    {
      "id": "retry-backoff",
      "type": "state-stepper",
      "title": "Retry scheduler: exponential backoff",
      "reason": "This change replaces the fixed one-second retry delay with exponential backoff capped at eight seconds, so a failing job stops hammering its dependency. Step through one failing job and two healthy ones to see when each retry is scheduled.",
      "initialStepper": "backoff",
      "steppers": [
        {
          "id": "backoff",
          "title": "After: exponential backoff",
          "code": {
            "language": "typescript",
            "lines": [
              "function enqueue(id: string, now: number): Job {",
              "  return { id, attempt: 0, nextRun: now, state: \"queued\" };",
              "}",
              "",
              "function scheduleRetry(job: Job, now: number): Job {",
              "  const attempt = job.attempt + 1;",
              "  if (attempt > MAX_ATTEMPTS) return { ...job, attempt, state: \"dead\" };",
              "  const delay = Math.min(BASE_MS * 2 ** (attempt - 1), CAP_MS);",
              "  return { ...job, attempt, nextRun: now + delay, state: \"waiting\" };",
              "}",
              "",
              "function onSuccess(job: Job): void {",
              "  queue.remove(job.id);",
              "}"
            ]
          },
          "columns": [
            {
              "id": "job",
              "label": "Job"
            },
            {
              "id": "attempt",
              "label": "Attempt"
            },
            {
              "id": "next-run",
              "label": "Next run"
            },
            {
              "id": "state",
              "label": "State"
            }
          ],
          "rowKey": "job",
          "steps": [
            {
              "id": "queued",
              "event": "Two jobs are queued",
              "caption": "Both jobs start with attempt 0 and are due to run straight away.",
              "at": "t = 0.0 s",
              "lines": {
                "from": 1,
                "to": 2
              },
              "rows": [
                {
                  "job": "export-17",
                  "attempt": "0",
                  "next-run": "0.0 s",
                  "state": "queued"
                },
                {
                  "job": "thumb-42",
                  "attempt": "0",
                  "next-run": "0.0 s",
                  "state": "queued"
                }
              ]
            },
            {
              "id": "first-failure",
              "event": "export-17 fails its first run",
              "caption": "Attempt 1 waits BASE_MS × 2⁰ = 1 s, the same delay as before this change.",
              "at": "t = 0.2 s",
              "lines": {
                "from": 6,
                "to": 9
              },
              "rows": [
                {
                  "job": "export-17",
                  "attempt": "1",
                  "next-run": "1.2 s",
                  "state": "waiting"
                },
                {
                  "job": "thumb-42",
                  "attempt": "0",
                  "next-run": "0.0 s",
                  "state": "queued"
                }
              ]
            },
            {
              "id": "thumb-done",
              "event": "thumb-42 succeeds",
              "caption": "A successful job leaves the queue, so its row is removed.",
              "at": "t = 0.4 s",
              "lines": {
                "from": 12,
                "to": 13
              },
              "rows": [
                {
                  "job": "export-17",
                  "attempt": "1",
                  "next-run": "1.2 s",
                  "state": "waiting"
                }
              ]
            },
            {
              "id": "second-failure",
              "event": "export-17 fails again",
