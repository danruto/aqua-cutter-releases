              "  const attempt = job.attempt + 1;",
              "  if (attempt > MAX_ATTEMPTS) return { ...job, attempt, state: \"dead\" };",
              "  return { ...job, attempt, nextRun: now + FIXED_MS, state: \"waiting\" };",
              "}"
            ]
          },
