                {
                  "component": "Accounts API",
                  "version": "api-41",
                  "settings": "Write plan and subscription."
                },
                {
                  "component": "Billing readers",
                  "version": "billing-17",
                  "settings": "Read users.plan; shadow-read subscriptions."
                }
              ],
              "gates": [
                {
                  "condition": "Mismatch log is empty for the previous phase.",
                  "assessment": "unknown"
