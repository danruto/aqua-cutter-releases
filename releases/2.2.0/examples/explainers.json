      "title": "Move plans to their own table",
      "reason": "A user's single plan column becomes a subscriptions table without downtime.",
      "rollouts": [
        {
          "id": "plan-to-subscriptions",
          "title": "users.plan to subscriptions",
          "map": {
            "source": "flowchart LR\n  api[Accounts API] -->|plan| old[users.plan column]\n  api -->|subscription| new[subscriptions table]\n  job[Backfill job] -->|copy| new\n  billing[Billing readers] -->|read old| old\n  billing -->|read new| new"
          },
          "phases": [
            {
              "id": "dual-write",
              "title": "Dual write",
              "intent": "Every write lands in both stores.",
              "invariant": "New writes reach both stores; reads still use the old column.",
              "components": [
                {
                  "component": "Accounts API",
                  "version": "api-41",
                  "settings": "Write plan and subscription."
                },
                {
                  "component": "Billing readers",
                  "version": "billing-17",
                  "settings": "Read users.plan."
                }
              ],
              "gates": [
                {
                  "condition": "Mismatch log is empty for the previous phase.",
                  "assessment": "met"
                }
              ],
              "existingWork": "Existing plans keep being served from whichever store this phase reads.",
              "newWork": "New plans follow this phase's write path.",
              "verification": [
                {
                  "check": "Compare row counts and a sample of plans between both stores."
                }
              ],
              "rollback": {
                "mode": "switch-back",
                "action": "Stop writing subscriptions.",
                "boundary": "Any time; no reader depends on the new table yet.",
                "existingWork": "Existing plans stay readable.",
                "newWork": "New plans keep their last write path."
              },
              "paths": [
                {
                  "edge": {
                    "from": "api",
                    "to": "old",
                    "label": "plan",
                    "occurrence": 0
                  },
                  "role": "write"
                },
                {
