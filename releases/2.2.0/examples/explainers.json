                    "label": "read old",
                    "occurrence": 0
                  },
                  "role": "off"
                },
                {
                  "edge": {
                    "from": "billing",
                    "to": "new",
                    "label": "read new",
                    "occurrence": 0
                  },
                  "role": "read"
                }
              ]
            },
            {
              "id": "drop-old",
              "title": "Drop the old column",
              "intent": "Stop writing the column, then drop it.",
              "invariant": "Only subscriptions is written and read. There is no way back after the drop.",
              "components": [
