    {
      "id": "pool-size",
      "type": "knob-table",
      "title": "Database connection pool size",
      "reason": "The pool size was raised from 8 to 16. This shows what each tested size did, so reviewers can see why 16 was picked over 32.",
      "knobs": [
        {
          "id": "connection-pool",
          "title": "Connection pool",
          "setting": "Pool size",
          "metrics": [
            {
              "id": "p95-latency",
              "label": "p95 latency",
              "unit": "ms",
              "better": "lower"
            },
            {
              "id": "error-rate",
              "label": "Error rate",
              "unit": "%",
              "better": "lower"
            }
          ],
          "points": [
            {
              "id": "size-4",
              "value": "4",
              "results": {
                "p95-latency": 410,
                "error-rate": 2.4
              },
              "basis": "measured",
              "note": "Requests queued for a free connection; timeouts drove the errors."
            },
            {
              "id": "size-8",
              "value": "8",
              "results": {
                "p95-latency": 180,
                "error-rate": 0.6
              },
              "basis": "measured",
              "note": "The previous setting."
            },
            {
              "id": "size-16",
              "value": "16",
              "results": {
                "p95-latency": 62,
                "error-rate": 0.1
              },
              "basis": "measured"
            },
            {
              "id": "size-32",
              "value": "32",
              "results": {
                "p95-latency": 64,
                "error-rate": 0.1
              },
              "basis": "measured",
              "note": "Database CPU rose 18% with no latency gain."
            }
          ],
          "chosen": "size-16",
          "rationale": "In the 30-minute load test at 400 requests per second, 16 connections removed the queueing seen at 8. Going to 32 gave no measurable gain and added database load, so 16 is the smallest size that holds the latency target."
        },
        {
          "id": "export-batch",
          "title": "Export batch size",
          "setting": "Rows per batch",
          "metrics": [
            {
              "id": "throughput",
              "label": "Throughput",
              "unit": "rows/s",
              "better": "higher"
            },
            {
              "id": "memory",
              "label": "Peak memory",
              "unit": "MB",
              "better": "lower"
            }
          ],
          "points": [
            {
              "id": "batch-500",
              "value": "500",
              "results": {
                "throughput": 4200,
                "memory": 140
              },
              "basis": "measured"
            },
            {
              "id": "batch-2000",
              "value": "2000",
              "results": {
                "throughput": 9800,
                "memory": 310
              },
              "basis": "measured"
            },
            {
              "id": "batch-10000",
              "value": "10000",
              "results": {
                "throughput": 11500,
                "memory": 1350
              },
              "basis": "estimated",
              "note": "Not run in full; scaled from a 10-minute sample."
            }
          ],
          "chosen": "batch-2000",
          "rationale": "2000 rows more than doubles throughput over 500 and stays well inside the 512 MB worker limit. 10000 would exceed that limit."
