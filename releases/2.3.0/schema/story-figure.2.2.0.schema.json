{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqua-cutter-render.local/story-figure.2.2.0.schema.json",
  "title": "StoryFigureDocument220",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "figure"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.2.0" },
    "figure": { "$ref": "#/$defs/storyFigure" }
  },
  "$defs": {
    "figureId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "figureTitle": { "type": "string", "pattern": "\\S", "maxUtf8Bytes": 512 },
    "figureNarration": { "type": "string", "pattern": "\\S", "maxUtf8Bytes": 2048 },
    "figureLabel": {
      "title": "FigureLabel",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "label": { "$ref": "#/$defs/figureTitle" }
      }
    },
    "figureReference": {
      "title": "FigureReference",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "pattern": "\\S", "maxUtf8Bytes": 256 },
        "value": { "$ref": "#/$defs/figureNarration" }
      }
    },
    "figureBeat": {
      "title": "FigureBeat",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "title": { "$ref": "#/$defs/figureTitle" },
        "explanation": { "$ref": "#/$defs/figureNarration" }
      }
    },
    "figureBase": {
      "title": "FigureBase",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "claim", "qualification", "references"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "title": { "$ref": "#/$defs/figureTitle" },
        "description": { "$ref": "#/$defs/figureNarration" },
        "claim": { "$ref": "#/$defs/figureTitle" },
        "qualification": { "$ref": "#/$defs/figureNarration" },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/figureReference" }
        }
      }
    },
    "flowPosition": {
      "title": "FlowPosition",
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "at"],
      "properties": {
        "token": { "$ref": "#/$defs/figureId" },
        "at": { "anyOf": [{ "$ref": "#/$defs/figureId" }, { "type": "null" }] },
        "via": { "$ref": "#/$defs/figureId" }
      }
    },
    "flowLink": {
      "title": "FlowLink",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "from": { "$ref": "#/$defs/figureId" },
        "to": { "$ref": "#/$defs/figureId" },
        "label": { "type": "string", "maxUtf8Bytes": 512 }
      }
    },
    "flowBeat": {
      "title": "FlowBeat",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation", "positions"],
      "properties": {
        "id": { "$ref": "#/$defs/figureBeat/properties/id" },
        "title": { "$ref": "#/$defs/figureBeat/properties/title" },
        "explanation": { "$ref": "#/$defs/figureBeat/properties/explanation" },
        "positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/flowPosition" }
        }
      }
    },
    "flowFigure": {
      "title": "FlowFigure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "claim",
        "qualification",
        "references",
        "kind",
        "places",
        "links",
        "tokens",
        "beats"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/figureBase/properties/id" },
        "title": { "$ref": "#/$defs/figureBase/properties/title" },
        "description": { "$ref": "#/$defs/figureBase/properties/description" },
        "claim": { "$ref": "#/$defs/figureBase/properties/claim" },
        "qualification": { "$ref": "#/$defs/figureBase/properties/qualification" },
        "references": { "$ref": "#/$defs/figureBase/properties/references" },
        "kind": { "const": "flow" },
        "places": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/figureLabel" }
        },
        "links": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/flowLink" } },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/figureLabel" }
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/flowBeat" }
        }
      }
    },
    "queuePosition": {
      "title": "QueuePosition",
      "type": "object",
      "discriminator": { "propertyName": "state" },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "state"],
          "properties": {
            "task": { "$ref": "#/$defs/figureId" },
            "state": { "enum": ["waiting", "done"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "state", "worker"],
          "properties": {
            "task": { "$ref": "#/$defs/figureId" },
            "state": { "const": "running" },
            "worker": { "$ref": "#/$defs/figureId" }
          }
        }
      ]
    },
    "queueBeat": {
      "title": "QueueBeat",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation", "available", "positions"],
      "properties": {
        "id": { "$ref": "#/$defs/figureBeat/properties/id" },
        "title": { "$ref": "#/$defs/figureBeat/properties/title" },
        "explanation": { "$ref": "#/$defs/figureBeat/properties/explanation" },
        "available": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/figureId" } },
        "positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/queuePosition" }
        }
      }
    },
    "queueFigure": {
      "title": "QueueFigure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "claim",
        "qualification",
        "references",
        "kind",
        "tasks",
        "workers",
        "beats"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/figureBase/properties/id" },
        "title": { "$ref": "#/$defs/figureBase/properties/title" },
        "description": { "$ref": "#/$defs/figureBase/properties/description" },
        "claim": { "$ref": "#/$defs/figureBase/properties/claim" },
        "qualification": { "$ref": "#/$defs/figureBase/properties/qualification" },
        "references": { "$ref": "#/$defs/figureBase/properties/references" },
        "kind": { "const": "queue" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/figureLabel" }
        },
        "workers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/figureLabel" }
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/queueBeat" }
        }
      }
    },
    "consolidationCopy": {
      "title": "ConsolidationCopy",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "object": { "$ref": "#/$defs/figureId" }
      }
    },
    "consolidationContainer": {
      "title": "ConsolidationContainer",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId" },
        "label": { "$ref": "#/$defs/figureTitle" },
        "kind": { "enum": ["pack", "group"] }
      }
    },
    "consolidationPosition": {
      "title": "ConsolidationPosition",
      "type": "object",
      "additionalProperties": false,
      "required": ["copy", "at"],
      "properties": {
        "copy": { "$ref": "#/$defs/figureId" },
        "at": { "anyOf": [{ "$ref": "#/$defs/figureId" }, { "type": "null" }] }
      }
    },
    "consolidationBeat": {
      "title": "ConsolidationBeat",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation", "visibleContainers", "positions"],
      "properties": {
        "id": { "$ref": "#/$defs/figureBeat/properties/id" },
        "title": { "$ref": "#/$defs/figureBeat/properties/title" },
        "explanation": { "$ref": "#/$defs/figureBeat/properties/explanation" },
        "visibleContainers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/figureId" }
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/consolidationPosition" }
        }
      }
    },
    "consolidationFigure": {
      "title": "ConsolidationFigure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "claim",
        "qualification",
        "references",
        "kind",
        "objects",
        "copies",
        "containers",
        "beats"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/figureBase/properties/id" },
        "title": { "$ref": "#/$defs/figureBase/properties/title" },
        "description": { "$ref": "#/$defs/figureBase/properties/description" },
        "claim": { "$ref": "#/$defs/figureBase/properties/claim" },
        "qualification": { "$ref": "#/$defs/figureBase/properties/qualification" },
        "references": { "$ref": "#/$defs/figureBase/properties/references" },
        "kind": { "const": "consolidation" },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/figureLabel" }
        },
        "copies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/consolidationCopy" }
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/consolidationContainer" }
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/consolidationBeat" }
        }
      }
    },
    "storyFigure": {
      "title": "StoryFigure",
      "type": "object",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        { "$ref": "#/$defs/flowFigure" },
        { "$ref": "#/$defs/queueFigure" },
        { "$ref": "#/$defs/consolidationFigure" }
      ]
    },
    "storyFigureSection": {
      "title": "StoryFigureSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "reason", "figure"],
      "properties": {
        "id": { "$ref": "#/$defs/figureId", "not": { "enum": ["overview", "exact-references"] } },
        "type": { "const": "story-figure" },
        "title": { "$ref": "#/$defs/figureTitle" },
        "reason": { "$ref": "#/$defs/figureNarration" },
        "figure": { "$ref": "#/$defs/storyFigure" }
      }
    },
    "figureStoryVisual": {
      "title": "FigureStoryVisual",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "section"],
      "properties": {
        "type": { "const": "figure" },
        "label": { "$ref": "#/$defs/figureTitle" },
        "section": { "$ref": "#/$defs/storyFigureSection/properties/id" }
      }
    }
  }
}
